<script>

/* PAGE TRANSITION */

const links =
document.querySelectorAll(
    "a"
);


links.forEach(
    function(link) {

        link.addEventListener(
            "click",
            function(event) {

                const href =
                    link.getAttribute(
                        "href"
                    );

                if (
                    !href ||
                    href.startsWith("#")
                ) {
                    return;
                }

                event.preventDefault();

                document.body.classList.add(
                    "leaving"
                );

                setTimeout(
                    function() {

                        window.location.href =
                            href;

                    },
                    400
                );

            }
        );

    }
);

</script>


